@model ClassLibrary.Student

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Student</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.FirstName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.FirstName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Surname)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Surname)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Age)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Age)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Email)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Email)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Eircode)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Eircode)
        </dd>
    </dl>
</div>

<!-- show students and lecturers -->
<h4>Enrolled Courses</h4>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Course Name</th>
            <th>QQI Level</th>
            <th>Lecturer</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Courses != null && Model.Courses.Any())
        {
            @foreach (var course in Model.Courses)
            {
                <tr>
                    <td>@course.CourseName</td>
                    <td>@course.QQILevel</td>
                    <td>@course.Lecturer.Title @course.Lecturer.FirstName @course.Lecturer.Surname</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="3">This student is not enrolled in any courses.</td>
            </tr>
        }
    </tbody>
</table>

<div>
    <a asp-action="Edit" asp-route-id="@Model?.ID">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
